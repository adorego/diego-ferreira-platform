.env.example
# ── apps/web ──────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:4000
JWT_SECRET=dev_secret_cambiar_en_prod
# También debe agregarse en Railway → @df/web → Variables con el mismo valor.
NEXT_PUBLIC_BANCARD_BASE_URL=https://vpos.infonet.com.py

# ── apps/api ──────────────────────────
DATABASE_URL=postgresql://df:df_dev@localhost:5432/df_platform
REDIS_URL=redis://localhost:6379
JWT_SECRET=dev_secret_cambiar_en_prod
FRONTEND_URL=http://localhost:3000
ADMIN_URL=http://localhost:3001

# Google Calendar
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_CALENDAR_ID=

# Daily.co (videollamada)
DAILY_API_KEY=
DAILY_DOMAIN=

# OpenAI (resumen IA)
OPENAI_API_KEY=

# Resend (emails)
RESEND_API_KEY=
DIEGO_EMAIL=diego@tudominio.com

# Bancard (pagos)
BANCARD_BASE_URL=https://vpos.infonet.com.py
BANCARD_PUBLIC_KEY=
BANCARD_PRIVATE_KEY=

# Bancard — return/cancel URLs para la compra del libro (opcional, default FRONTEND_URL/avanza/*)
BANCARD_RETURN_URL_LIBRO=
BANCARD_CANCEL_URL_LIBRO=

# Precio del libro (PYG porque Bancard staging solo tiene esa moneda habilitada;
# cambiar BOOK_CURRENCY a USD cuando esté habilitado en Bancard producción)
BOOK_AMOUNT=95000
BOOK_CURRENCY=PYG