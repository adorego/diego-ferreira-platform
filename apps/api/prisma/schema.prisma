generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           Int       @id @default(autoincrement())
  email        String    @unique
  name         String
  passwordHash String
  role         Role      @default(PATIENT)
  status       UserStatus @default(PROSPECT)
  country      String?
  gcalToken    String?
  sessions     Session[]
  payments     Payment[]
  createdAt    DateTime  @default(now())
}

model Session {
  id              Int        @id @default(autoincrement())
  patientId       Int
  patient         User       @relation(fields:[patientId], references:[id])
  type            SessionType
  status          AppStatus  @default(PENDING)
  start           DateTime?
  end             DateTime?
  roomUrl         String?
  gcalEventId     String?
  recordingUrl    String?
  reminderSent    Boolean    @default(false)
  price           Float?
  paymentId       String?
  payment         Payment?   @relation(fields:[paymentId], references:[id])
  summary         SessionSummary?
  schedulingToken String?
  // No estaba en el schema pedido, pero sin persistir esto en algún lado el
  // webhook no tiene de dónde sacar "totalSessions" para el JWT de agendamiento —
  // admitPatient() solo usaba dto.sessions de forma transitoria (precio/email),
  // nunca lo guardaba. Ver patients.service.ts.
  totalSessions   Int        @default(1)
  bookings        SessionBooking[]
  createdAt       DateTime   @default(now())
}

model SessionBooking {
  id            Int      @id @default(autoincrement())
  sessionId     Int
  session       Session  @relation(fields: [sessionId], references: [id])
  googleEventId String
  meetLink      String?
  start         DateTime
  end           DateTime
  type          String
  createdAt     DateTime @default(now())
}

model SessionSummary {
  id          String   @id @default(cuid())
  sessionId   Int      @unique
  session     Session  @relation(fields:[sessionId], references:[id])
  transcript  String   @db.Text
  summary     String   @db.Text
  createdAt   DateTime @default(now())
}

model Payment {
  id               String    @id @default(cuid())
  patientId        Int
  patient          User      @relation(fields:[patientId], references:[id])
  amount           Float
  currency         String
  status           PayStatus @default(PENDING)
  bancardProcessId String?   @unique
  authNumber       String?
  sessions         Session[]
  createdAt        DateTime  @default(now())
}

model BookPurchase {
  id            Int       @id @default(autoincrement())
  shopProcessId String    @unique
  email         String
  nombre        String
  amount        String    @default("12.99")
  currency      String    @default("USD")
  status        String    @default("PENDING")
  downloadToken String?   @unique
  downloadedAt  DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

enum Role {
  PATIENT
  ADMIN
}

enum UserStatus {
  PROSPECT
  APPROVED
  ACTIVE
  INACTIVE
}

enum SessionType {
  EXPLORATORY
  PLAN
}

enum AppStatus {
  PENDING
  CONFIRMED
  PAID
  COMPLETED
  CANCELLED
}

enum PayStatus {
  PENDING
  CONFIRMED
  FAILED
}